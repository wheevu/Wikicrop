{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikicrop.local/schema/reviewed-query.v1.schema.json",
  "title": "Experimental offline reviewed query contract",
  "x-predicate-canonical-map": {
    "height": "plant_height",
    "plant_height": "plant_height",
    "maturity": "growth_duration",
    "duration": "growth_duration",
    "growth_duration": "growth_duration",
    "yield": "yield_amount",
    "yield_amount": "yield_amount"
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "crop_id"],
      "properties": {
        "type": {"enum": ["Crop", "Variety", "Pest"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "crop_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "oneOf": [{"required": ["id"]}, {"required": ["name"]}]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "op", "value"],
      "properties": {
        "predicate": {"enum": ["height", "plant_height", "maturity", "duration", "growth_duration", "yield", "yield_amount"]},
        "op": {"enum": ["<", "<=", ">", ">=", "="]},
        "value": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?\\s*[^0-9\\s].*$"},
        "on": {"enum": ["root", "target"]}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "entities"],
      "properties": {
        "intent": {"enum": ["lookup", "path", "filter"]},
        "entities": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/entity"}},
        "max_depth": {"type": "integer", "minimum": 1, "maximum": 3},
        "path": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"enum": ["HAS_VARIETY", "HAS_PARENT", "PARENT_OF", "RESISTANT_TO", "SUSCEPTIBLE_TO", "AFFECTED_BY"]}},
        "target": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"enum": ["Crop", "Variety", "Pest"]}, "id": {"type": "string", "minLength": 1, "maxLength": 512}}},
        "filters": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/filter"}},
        "qualifiers": {"type": "object", "additionalProperties": false, "properties": {"season": {"type": "string"}, "condition": {"type": "string"}}}
      },
      "allOf": [
        {"if": {"properties": {"intent": {"const": "path"}}, "required": ["intent"]}, "then": {"required": ["path"]}},
        {"if": {"properties": {"intent": {"not": {"const": "path"}}}, "required": ["intent"]}, "then": {"not": {"anyOf": [{"required": ["path"]}, {"required": ["target"]}, {"required": ["max_depth"]}]}}}
      ]
    }
  },
  "type": "object",
  "required": ["generation", "semantic_version", "offline_only", "completeness_scope", "status", "complete", "results"],
  "properties": {
    "generation": {"type": "string"},
    "semantic_version": {"const": "wikikg.reviewed-query.v1"},
    "offline_only": {"const": true},
    "completeness_scope": {"const": "manifest"},
    "status": {"enum": ["ok", "empty", "unsupported", "truncated", "dependency_failure"]},
    "complete": {"type": "boolean"},
    "partial": {"type": "boolean"},
    "reason": {"type": "string"},
    "claims_scanned": {"type": "integer", "minimum": 0},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "claims"],
        "properties": {
          "subject": {"type": "object", "required": ["type", "id", "crop_id"], "properties": {"type": {"type": "string"}, "id": {"type": "string"}, "crop_id": {"type": "string"}}},
          "claims": {"type": "array", "items": {"type": "object", "required": ["claim", "citation", "evidence"], "properties": {
            "claim": {"type": "object"},
            "citation": {"type": "object", "required": ["snapshot_id", "snapshot_hash", "review_version"], "properties": {"snapshot_id": {"type": "string"}, "snapshot_hash": {"type": "string"}, "review_version": {"type": "integer"}}, "additionalProperties": false},
            "evidence": {"type": "array"}
          }}}
        }
      }
    }
  },
  "additionalProperties": false
}
