{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikicrop.local/schema/evaluation-report.v1.schema.json",
  "title": "WikiKGExtractor engineering pilot report",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "split",
    "status",
    "environment",
    "artifact_hashes",
    "runs",
    "checks",
    "summary",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol_id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["development", "heldout"] },
    "status": { "enum": ["pass", "fail"] },
    "environment": {
      "type": "object",
      "required": ["python_version", "platform", "repository_revision"],
      "properties": {
        "python_version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "repository_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "artifact_hashes": {
      "type": "object",
      "required": ["manifest", "input", "worker", "evaluator", "protocol"],
      "properties": {
        "manifest": { "$ref": "#/$defs/sha256" },
        "input": { "$ref": "#/$defs/sha256" },
        "worker": { "$ref": "#/$defs/sha256" },
        "evaluator": { "$ref": "#/$defs/sha256" },
        "protocol": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["hash_seed", "duration_seconds", "exit_code", "output_hashes"],
        "properties": {
          "hash_seed": { "enum": [0, 1] },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "exit_code": { "type": "integer" },
          "output_hashes": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/sha256" }
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "artifact_hashes_match",
        "schemas_valid",
        "source_records_match_manifest",
        "evidence_revalidated",
        "graph_invariants_valid",
        "outputs_deterministic"
      ],
      "properties": {
        "artifact_hashes_match": { "type": "boolean" },
        "schemas_valid": { "type": "boolean" },
        "source_records_match_manifest": { "type": "boolean" },
        "evidence_revalidated": { "type": "boolean" },
        "graph_invariants_valid": { "type": "boolean" },
        "outputs_deterministic": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "page_count",
        "node_count",
        "edge_count",
        "candidate_claim_count",
        "traceability_complete_count",
        "traceability_coverage",
        "nodes_by_label",
        "edges_by_type",
        "claims_by_predicate",
        "input_error_count",
        "skipped_source_page_count",
        "warning_count",
        "worker_failure_count"
      ],
      "properties": {
        "page_count": { "type": "integer", "minimum": 0 },
        "node_count": { "type": "integer", "minimum": 0 },
        "edge_count": { "type": "integer", "minimum": 0 },
        "candidate_claim_count": { "type": "integer", "minimum": 0 },
        "traceability_complete_count": { "type": "integer", "minimum": 0 },
        "traceability_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "nodes_by_label": { "$ref": "#/$defs/countMap" },
        "edges_by_type": { "$ref": "#/$defs/countMap" },
        "claims_by_predicate": { "$ref": "#/$defs/countMap" },
        "input_error_count": { "type": "integer", "minimum": 0 },
        "skipped_source_page_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "worker_failure_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
