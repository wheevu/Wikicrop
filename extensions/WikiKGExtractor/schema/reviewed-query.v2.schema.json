{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikicrop.local/schema/reviewed-query.v2.schema.json",
  "title": "Experimental offline reviewed query semantic v2",
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "crop_id"],
      "properties": {
        "type": {"enum": ["Crop", "Variety", "Pest"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "crop_id": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "oneOf": [{"required": ["id"]}, {"required": ["name"]}]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "op", "value"],
      "properties": {
        "predicate": {"enum": ["height", "plant_height", "maturity", "duration", "growth_duration", "yield", "yield_amount"]},
        "op": {"enum": ["<", "<=", ">", ">=", "="]},
        "value": {"type": "string", "minLength": 1, "maxLength": 128},
        "on": {"enum": ["root", "target"]}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["Crop", "Variety", "Pest"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"enum": ["HAS_VARIETY", "HAS_PARENT", "PARENT_OF", "RESISTANT_TO", "SUSCEPTIBLE_TO", "AFFECTED_BY"]}
        },
        "target": {"$ref": "#/$defs/target"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "entities"],
      "properties": {
        "intent": {"enum": ["lookup", "path", "filter", "conjunction"]},
        "purpose": {"enum": ["evidence", "answer"]},
        "entities": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/entity"}},
        "max_depth": {"type": "integer", "minimum": 1, "maximum": 3},
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"enum": ["HAS_VARIETY", "HAS_PARENT", "PARENT_OF", "RESISTANT_TO", "SUSCEPTIBLE_TO", "AFFECTED_BY"]}
        },
        "target": {"$ref": "#/$defs/target"},
        "branches": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/branch"}},
        "filters": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/filter"}},
        "qualifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "season": {"type": "string", "maxLength": 512},
            "condition": {"type": "string", "maxLength": 512}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"intent": {"const": "lookup"}}, "required": ["intent"]},
          "then": {"not": {"anyOf": [{"required": ["path"]}, {"required": ["target"]}, {"required": ["branches"]}, {"required": ["max_depth"]}]}}
        },
        {
          "if": {"properties": {"intent": {"const": "filter"}}, "required": ["intent"]},
          "then": {"not": {"anyOf": [{"required": ["path"]}, {"required": ["target"]}, {"required": ["branches"]}, {"required": ["max_depth"]}]}}
        },
        {
          "if": {"properties": {"intent": {"const": "path"}}, "required": ["intent"]},
          "then": {
            "required": ["path"],
            "not": {"required": ["branches"]},
            "allOf": [{
              "if": {"properties": {"filters": {"contains": {"properties": {"on": {"const": "target"}}, "required": ["on"]}}}, "required": ["filters"]},
              "then": {"required": ["target"]}
            }]
          }
        },
        {
          "if": {"properties": {"intent": {"const": "conjunction"}}, "required": ["intent"]},
          "then": {
            "required": ["branches"],
            "not": {"anyOf": [
              {"required": ["path"]},
              {"required": ["target"]},
              {"required": ["max_depth"]},
              {"properties": {"filters": {"contains": {"properties": {"on": {"const": "target"}}, "required": ["on"]}}}, "required": ["filters"]}
            ]}
          }
        }
      ]
    }
  },
  "type": "object",
  "required": ["generation", "semantic_version", "scope_policy_version", "offline_only", "completeness_scope", "status", "complete", "results"],
  "properties": {
    "generation": {"type": "string"},
    "semantic_version": {"const": "wikikg.reviewed-query.v2"},
    "scope_policy_version": {"type": "string"},
    "offline_only": {"const": true},
    "completeness_scope": {"const": "manifest"},
    "status": {"enum": ["ok", "empty", "unsupported", "truncated", "dependency_failure"]},
    "complete": {"type": "boolean"},
    "partial": {"type": "boolean"},
    "reason": {"type": "string"},
    "reasons": {"type": "array", "items": {"type": "object"}},
    "claims_scanned": {"type": "integer", "minimum": 0},
    "results": {"type": "array"}
  },
  "additionalProperties": true
}
