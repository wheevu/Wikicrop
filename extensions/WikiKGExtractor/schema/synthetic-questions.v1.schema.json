{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikicrop.local/schema/synthetic-questions.v1.schema.json",
  "title": "Server-owned synthetic question catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "questions"],
  "properties": {
    "version": {"const": "wikikg.synthetic-questions.v1"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "Question IDs must also be distinct, checked by the runtime.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "query"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 160},
          "query": {
            "type": "object",
            "description": "Validated against reviewed-query.v2 request semantics before interpretation. No generator or unrestricted Cypher is accepted."
          }
        }
      }
    }
  }
}
