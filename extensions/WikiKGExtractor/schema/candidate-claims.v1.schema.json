{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikicrop.local/schema/candidate-claims.v1.schema.json",
  "title": "WikiKGExtractor provisional candidate claims",
  "type": "object",
  "required": ["schema_version", "metadata", "summary", "claims"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "metadata": {
      "type": "object",
      "required": ["extractor_version", "extraction_method", "review_state", "source_pages"],
      "properties": {
        "extractor_version": { "type": "string", "minLength": 1 },
        "extraction_method": { "enum": ["rules", "ai"] },
        "review_state": { "const": "pending" },
        "source_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "page_id", "revision_id", "content_hash"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "page_id": { "type": "integer", "minimum": 1 },
              "revision_id": { "type": "integer", "minimum": 1 },
              "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["claim_count", "traceability_complete_count", "claims_by_predicate"],
      "properties": {
        "claim_count": { "type": "integer", "minimum": 0 },
        "traceability_complete_count": { "type": "integer", "minimum": 0 },
        "claims_by_predicate": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "skipped_source_pages": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "entityRef": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["Crop", "Variety", "Pest"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "page_id",
        "revision_id",
        "content_hash",
        "page_title",
        "extraction_method",
        "extractor_version",
        "location_type"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "page_id": { "type": "integer", "minimum": 1 },
        "revision_id": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "page_title": { "type": "string", "minLength": 1 },
        "extraction_method": { "enum": ["rules", "ai"] },
        "extractor_version": { "type": "string", "minLength": 1 },
        "location_type": { "enum": ["source_span", "page_title", "page"] },
        "location": { "type": "string" },
        "source_offset_start": { "type": "integer", "minimum": 0 },
        "source_offset_end": { "type": "integer", "minimum": 1 },
        "supporting_span": { "type": "string", "minLength": 1 },
        "span_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "location_type": { "const": "source_span" } },
            "required": ["location_type"]
          },
          "then": {
            "required": [
              "source_offset_start",
              "source_offset_end",
              "supporting_span",
              "span_hash"
            ]
          }
        },
        {
          "if": {
            "properties": { "location_type": { "const": "page_title" } },
            "required": ["location_type"]
          },
          "then": {
            "required": ["location"]
          }
        }
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "claim_type",
        "subject",
        "predicate",
        "qualifiers",
        "evidence",
        "traceability_complete",
        "review"
      ],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "claim_type": { "enum": ["relationship", "property"] },
        "subject": { "$ref": "#/$defs/entityRef" },
        "predicate": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/entityRef" },
        "value": { "type": "string", "minLength": 1 },
        "qualifiers": { "type": "object" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "traceability_complete": { "type": "boolean" },
        "review": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "const": "pending" }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        {
          "required": ["object"],
          "not": { "required": ["value"] }
        },
        {
          "required": ["value"],
          "not": { "required": ["object"] }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": { "traceability_complete": { "const": true } },
            "required": ["traceability_complete"]
          },
          "then": {
            "properties": {
              "evidence": {
                "items": {
                  "properties": {
                    "location_type": { "enum": ["source_span", "page_title"] }
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
